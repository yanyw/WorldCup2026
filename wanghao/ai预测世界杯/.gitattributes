# Normalize text files across Windows, macOS and Linux.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf

# Research source binaries. Run `git lfs install` before the first `git add`.
*.pdf filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
data/raw/polymarket/*_live_*.json filter=lfs diff=lfs merge=lfs -text
